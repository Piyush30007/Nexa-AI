import core
import guardrails

flow main
  activate user said something

flow input rails $input_text
  $is_allowed = await CheckUserUtteranceAction(input_text=$input_text)

  if not $is_allowed
    bot say "I'm sorry, I can only assist with questions related to the company's policies, documents, and supported financial information."
    abort

  return

flow output rails $output_text
  $is_safe = await CheckBotResponseAction(output_text=$output_text)

  if not $is_safe
    bot say "I cannot provide this response because it contains unverified or sensitive information. Please refer to official company policy documentation."
    abort

  return